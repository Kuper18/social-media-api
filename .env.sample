# database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=social_media_api
POSTGRES_HOST=db
POSTGRES_PORT=5432

# redis
REDIS_PASSWORD=password
REDIS_HOST=redis
REDIS_PORT=6379

# app
APP_ENV=development
SECRET_KEY=django-secret-key
FRONTEND_URL=http://127.0.0.1:3000

# JWT
JWT_SECRET=jwt-secret
# lifetime in minutes
JWT_ACCESS_TOKEN_LIFETIME=5
#lifetime in days
JWT_REFRESH_TOKEN_LIFETIME=1

# email
DEFAULT_FROM_EMAIL=supprt@social-media.com
EMAIL_HOST=mailpit
EMAIL_PORT=1024
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# cloud storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_FILE_OVERWRITE=
AWS_S3_REGION_NAME=
AWS_DEFAULT_ACL=
AWS_QUERYSTRING_AUTH=
AWS_S3_SIGNATURE_VERSION=
AWS_S3_CUSTOM_DOMAIN=